/* .vscode/tasks.json */
{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build Playdate (Lua → .pdx)",
      "type": "shell",
      "command": "pdc",
      "args": [
        ".",
        "./build/Game.pdx"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Run Simulator",
      "type": "shell",
      "command": "open",
      "args": [
        "-a",
        "Playdate Simulator",
        "${workspaceFolder}/build/Game.pdx"
      ],
      "dependsOn": "Build Playdate (Lua → .pdx)"
    }
  ]
}
